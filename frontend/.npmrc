# npm 10 introduced a new allow-scripts enforcement layer that is separate from
# ignore-scripts. Packages must be explicitly approved or the postinstall is
# blocked, which leaves node_modules/.bin symlinks without the execute bit.
#
# Approve esbuild's postinstall — it downloads the platform-specific native
# binary that Vite requires. Without it, `vite build` exits 126 (permission
# denied) because the .bin symlink is created but not marked executable.
scripts.esbuild@0.21.5=true

# Belt-and-suspenders: also disable the old ignore-scripts guard.
ignore-scripts=false
